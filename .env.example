# Vonage auth (JWT via application)
VONAGE_APPLICATION_ID=
# Either an absolute path, relative path (from repo root), OR paste the full PEM contents.
VONAGE_PRIVATE_KEY_PATH=./private.key

# Call configuration
FROM_NUMBER=+12025550123
TO_NUMBER=+12025550124

# Branding
COMPANY_NAME=Acme Co
GREETING=We are calling to confirm your appointment.

# Local server
PORT=3000

# Public base URL (ngrok HTTPS URL)
PUBLIC_BASE_URL=https://xxxx.ngrok.app
